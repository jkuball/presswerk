---
import DefaultHead from '@astrojs/starlight/components/Head.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const pathname = Astro.url.pathname;
const slug = pathname === base ? 'index' : pathname.startsWith(base) && pathname.endsWith('/') ? pathname.slice(base.length, -1) : null;
const markdown = slug === null ? null : `${base}${slug}.md`;
---

<DefaultHead />
{markdown && <link rel="alternate" type="text/markdown" href={markdown} title="Markdown" />}
