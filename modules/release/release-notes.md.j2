{% set count = groups | map(attribute="commits") | map("length") | sum %}{% if unreleased %}{{ unreleased }}
{% if groups %}
<details>
<summary>Commits ({{ count }})</summary>

{% for group in groups %}{% set emoji = group.title | split(" ") | first %}{% for commit in group.commits %}- {{ emoji }} {{ commit.text }}
{% endfor %}{% endfor %}
</details>
{% endif %}{% elif groups %}{% for group in groups %}{% set emoji = group.title | split(" ") | first %}{% for commit in group.commits %}- {{ emoji }} {{ commit.text }}
{% endfor %}{% endfor %}{% else %}No recorded changes.
{% endif %}
